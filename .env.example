# ============================================
# 微信公众号运营自动化 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值，.env 不会被 Git 追踪
# ============================================

# --- API Keys ---
# 极致了 API（公众号文章搜索）
DAJIALA_API_KEY=JZL-YOUR_DAJIALA_API_KEY_HERE

# 简立制作 API（草稿上传 + 自动回复管理）
JIANLIZHIZUO_API_KEY=sk-YOUR_JIANLIZHIZUO_API_KEY_HERE

# --- 飞书 Base ---
# Base Token（选题库）
FEISHU_BASE_TOKEN=YOUR_FEISHU_BASE_TOKEN_HERE

# 文章素材表 ID
FEISHU_ARTICLE_TABLE_ID=tblYOUR_ARTICLE_TABLE_ID_HERE

# 搜索文章池表 ID
FEISHU_SEARCH_POOL_TABLE_ID=tblYOUR_SEARCH_POOL_TABLE_ID_HERE

# 账号配置表 ID
FEISHU_ACCOUNT_TABLE_ID=tblYOUR_ACCOUNT_TABLE_ID_HERE

# --- 微信公众号（按账号填充，用于自动回复）---
# 在各自动回复脚本的 ACCOUNT_MAP 中配置，如：
# ACCOUNT_MAP = {
#     "Joblinker": os.getenv("WECHAT_APPID_JOBLINKER", "wxYOUR_APPID_HERE"),
#     "行研实习": os.getenv("WECHAT_APPID_XINGYAN", "wxYOUR_APPID_HERE"),
# }
